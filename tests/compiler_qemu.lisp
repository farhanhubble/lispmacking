(define twice (lambda (x) (+ x x)))
(define positive-twice (lambda (x) (cond ((< x 0) 0) (t (twice x)))))
(define code-page (bootstrap:code-page-allocate))
(compiler-compile-program code-page '((twice-native (x) (+ x x)) (positive-native (x) (cond ((< x 0) 0) (t (twice-native x)))) (store-native (x) (store-u64 x (twice-native 21))) (load-native (x) (load-u64 x))))
(= (bootstrap:call-native code-page 21) (twice 21))
(= (bootstrap:call-native (+ code-page 256) 21) (positive-twice 21))
(= (bootstrap:call-native (+ code-page 256) -1) (positive-twice -1))
(define data-page (bootstrap:page-allocate))
(bootstrap:call-native (+ code-page 512) data-page)
(= (bootstrap:load-u64 data-page) (twice 21))
(= (bootstrap:call-native (+ code-page 768) data-page) (twice 21))
(bootstrap:call-native (+ code-page 2) 1)
(bootstrap:call-native data-page 1)
(bootstrap:call-native 0 1)
(define rejected-page (bootstrap:page-allocate))
(compiler-compile-program rejected-page '((bad (x) missing)))
(positive-twice 21)
